const GL={};GTXT.split('\n').forEach(l=>{const i=l.indexOf('=');if(i>0)GL[l.slice(0,i)]=l.slice(i+1)});
const GRX=new RegExp('(?<![\\u0900-\\u097F])(?:'+Object.keys(GL).sort((a,b)=>b.length-a.length).map(k=>k.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')).join('|')+')(?![\\u0900-\\u097F])','g');
const CONS={'क':'k','ख':'kh','ग':'g','घ':'gh','ङ':'ng','च':'ch','छ':'chh','ज':'j','झ':'jh','ञ':'n','ट':'t','ठ':'th','ड':'d','ढ':'dh','ण':'n','त':'t','थ':'th','द':'d','ध':'dh','न':'n','प':'p','फ':'ph','ब':'b','भ':'bh','म':'m','य':'y','र':'r','ल':'l','व':'b','श':'sh','ष':'sh','स':'s','ह':'h'};
const IVW={'अ':'a','आ':'a','इ':'i','ई':'i','उ':'u','ऊ':'u','ऋ':'ri','ए':'e','ऐ':'ai','ओ':'o','औ':'au'};
const MAT={'ा':'a','ि':'i','ी':'i','ु':'u','ू':'u','े':'e','ै':'ai','ो':'o','ौ':'au','ृ':'ri'};
function tl(w){w=w.replace(/[‌‍]/g,'').replace(/ज्ञ/g,'');const ch=[...w];let o='';for(let i=0;i<ch.length;i++){const c=ch[i];if(c===''||CONS[c]!==undefined){o+=c===''?'gy':CONS[c];let n=ch[i+1];if(n==='़'){i++;n=ch[i+1]}if(n==='्'){i++;continue}if(n!==undefined&&MAT[n]!==undefined){o+=MAT[n];i++;continue}if(i>=ch.length-1||ch[i-1]==='्')o+='a';else if(i===ch.length-1)o+='';else o+='a'}else if(IVW[c]!==undefined)o+=IVW[c];else if(c==='ं'||c==='ँ')o+='n';else if(c==='ः')o+='h';else if(c==='्'||c==='़'){}else o+=c}return o.charAt(0).toUpperCase()+o.slice(1)}
function convertNe(t){t=String(t==null?'':t);if(!t.trim())return '';const parts=[];let s=t.replace(GRX,m=>{parts.push(GL[m]);return '\u0002'+(parts.length-1)+'\u0003'});s=s.replace(/[०-९]/g,d=>'०१२३४५६७८९'.indexOf(d)).replace(/[।॥]/g,'.');s=s.replace(/[ऀ-ॿ]+/g,w=>tl(w));s=s.replace(/\u0002(\d+)\u0003/g,(m,i)=>parts[+i]);return s.replace(/[ \t]{2,}/g,' ').replace(/ +([,.;:])/g,'$1').replace(/^ +| +$/gm,'').trim()}
