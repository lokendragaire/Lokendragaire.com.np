  const prev=list('closings').filter(c=>c.date<date).sort((a,b)=>b.date.localeCompare(a.date))[0];
  const opening=cl?cl.opening:(prev?prev.counted:0);CLS={cash:st.rec.cash,exCash:st.exCash};
  const exps=list('expenses').filter(e=>e.date===date);
  return `<div class="row"><label style="margin:0">मिति</label><input type="date" value="${date}" onchange="setF('closing','date',this.value,true)" style="max-width:170px"></div>
  <div class="stats"><div class="stat"><span>बिल</span><b>${st.n}</b></div><div class="stat"><span>कुल बिल</span><b>${fmt(st.billed)}</b></div><div class="stat"><span>प्राप्त नगद</span><b>${fmt(st.rec.cash)}</b></div><div class="stat"><span>प्राप्त अनलाइन</span><b>${fmt(st.rec.online)}</b></div><div class="stat"><span>उधारो</span><b>${fmt(st.credit)}</b></div><div class="stat"><span>नगद खर्च</span><b>${fmt(st.exCash)}</b></div><div class="stat"><span>खरिद</span><b>${fmt(st.purchTotal)}</b></div></div>
  <div class="card"><h3>🔒 नगद मिलान</h3><div class="g2"><div><label>सुरुको नगद</label><input id="cl_open" type="number" step="any" value="${opening}" oninput="clCalc()"></div><div><label>दराजमा हुनुपर्ने</label><div class="big" id="cl_exp">${fmt(num(opening)+st.rec.cash-st.exCash)}</div></div><div><label>वास्तविक गनेको</label><input id="cl_cnt" type="number" step="any" value="${cl?cl.counted:''}" oninput="clCalc()"></div><div><label>फरक</label><div class="big" id="cl_diff">${cl?fmt(cl.diff):'—'}</div></div></div><label>कैफियत</label><input id="cl_note" value="${esc(cl?cl.note:'')}"><div class="foot"><button class="btn bg" onclick="saveClosing()">✅ सेभ</button></div></div>
  <div class="card"><div class="row"><h3 style="margin:0;flex:1">खर्च</h3><button class="btn bp bs" onclick="expForm()">＋</button></div>${tbl(['वर्ग','विवरण','माध्यम','रकम|r',''],exps.map(e=>`<tr><td>${esc(e.cat)}</td><td>${esc(e.note||'')}</td><td>${e.method==='online'?'अनलाइन':'नगद'}</td><td class="r">${fmt(e.amt)}</td><td><button class="btn bs" onclick="expForm('${e.id}')">✏️</button> <button class="btn bs bd" onclick="delExp('${e.id}')">🗑️</button></td></tr>`),'खर्च छैन')}</div>`}};
function clCalc(){const o=num($('#cl_open').value),exp=o+CLS.cash-CLS.exCash;$('#cl_exp').textContent=fmt(exp);const c=$('#cl_cnt').value;$('#cl_diff').textContent=c===''?'—':fmt(num(c)-exp)}
function saveClosing(){if(ME.role!=='admin'){toast('अनुमति छैन','err');return}const date=fget('closing','date',today()),st=dayStats(date);if($('#cl_cnt').value===''){toast('गनेको नगद','err');return}const opening=num($('#cl_open').value),counted=num($('#cl_cnt').value),exp=opening+st.rec.cash-st.exCash;put('closings',{id:'c_'+date,date,opening,cashIn:st.rec.cash,onlineIn:st.rec.online,expCash:st.exCash,purchT:st.purchTotal,expected:exp,counted,diff:counted-exp,billed:st.billed,n:st.n,note:$('#cl_note').value,by:ME.id,byName:ME.name,at:now()});log('closing',`हिसाब (${date}) — फरक ${fmt(counted-exp)}`);toast('सेभ','ok')}

/* Accounts (admin) */
function range(){return[fget('accounts','from',today().slice(0,8)+'01'),fget('accounts','to',today())]}
const inR=(ts,R)=>{const d=dOf(ts);return d>=R[0]&&d<=R[1]};
function accPre(k){const t=today();let f=t;if(k==='week')f=ds(new Date(now()-6*864e5));else if(k==='month')f=t.slice(0,8)+'01';else if(k==='all')f='2000-01-01';F.accounts=Object.assign(F.accounts||{},{from:f,to:t});renderPage()}
PAGES.accounts={title:'लेखा / रिपोर्ट',html(){
  if(ME.role!=='admin')return '<p class="mut">यो पेज हेर्ने अनुमति छैन।</p>';
  const R=range(),tab=fget('accounts','tab','sum');
  return `<div class="row"><label style="margin:0">देखि</label><input type="date" value="${R[0]}" onchange="setF('accounts','from',this.value,true)" style="max-width:160px"><label style="margin:0">सम्म</label><input type="date" value="${R[1]}" onchange="setF('accounts','to',this.value,true)" style="max-width:160px"><button class="btn bs" onclick="accPre('today')">आज</button><button class="btn bs" onclick="accPre('week')">७ दिन</button><button class="btn bs" onclick="accPre('month')">महिना</button><button class="btn bs" onclick="accPre('all')">सबै</button></div><div class="tabs">${[['sum','सारांश'],['ledger','खाता'],['purch','खरिद'],['udhar','उधारो'],['exp','खर्च'],['staff','स्टाफ']].map(([k,l])=>`<button class="${tab===k?'on':''}" onclick="setF('accounts','tab','${k}',true)">${l}</button>`).join('')}</div>${accTab(tab,R)}`}};
function accData(R){const all=allBills(),bills=all.filter(b=>inR(b.createdAt,R)),pays=[];all.forEach(b=>(b.payments||[]).forEach(p=>{if(inR(p.at,R))pays.push(Object.assign({},p,{no:b.no,cust:b.customerName,type:b.type}))}));const exps=list('expenses').filter(e=>e.date>=R[0]&&e.date<=R[1]);const purch=list('purchases').filter(p=>p.date>=R[0]&&p.date<=R[1]);const cogs=bills.filter(b=>b.type==='pos').reduce((s,b)=>s+(b.lines||[]).reduce((q,l)=>q+num(l.cost)*num(l.qty),0),0);return{all,bills,pays,exps,purch,cogs}}
function accTab(tab,R){
  const D=accData(R),billed=D.bills.reduce((s,b)=>s+num(b.total),0),recv=D.pays.reduce((s,p)=>s+num(p.amt),0),expT=D.exps.reduce((s,e)=>s+num(e.amt),0),purchT=D.purch.reduce((s,p)=>s+num(p.total),0);
  if(tab==='sum'){
    const byT={};D.bills.forEach(b=>{const k=b.type;(byT[k]=byT[k]||{n:0,t:0}).n++;byT[k].t+=num(b.total)});
    const byC={};D.exps.forEach(e=>{byC[e.cat]=(byC[e.cat]||0)+num(e.amt)});
    const cashR=D.pays.filter(p=>p.method!=='online').reduce((s,p)=>s+num(p.amt),0);
    const gp=billed-D.cogs,net=gp-D.exps.filter(e=>!e.ref).reduce((s,e)=>s+num(e.amt),0);
    return `<div class="stats"><div class="stat"><span>कुल बिक्री</span><b>${fmt(billed)}</b></div><div class="stat"><span>प्राप्त</span><b>${fmt(recv)}</b><span>नगद ${fmt(cashR)} · अनलाइन ${fmt(recv-cashR)}</span></div><div class="stat"><span>COGS</span><b>${fmt(D.cogs)}</b></div><div class="stat"><span>Gross Profit</span><b>${fmt(gp)}</b></div><div class="stat"><span>सञ्चालन खर्च</span><b>${fmt(expT)}</b></div><div class="stat"><span>Net Profit</span><b>${fmt(net)}</b></div><div class="stat"><span>कुल खरिद</span><b>${fmt(purchT)}</b></div><div class="stat"><span>नगद आधार</span><b>${fmt(recv-expT)}</b></div></div>
    <div class="g2"><div class="card"><h3>सेवा अनुसार</h3>${tbl(['प्रकार','बिल|r','रकम|r'],Object.keys(byT).map(k=>`<tr><td>${TY[k][2]} ${TY[k][0]}</td><td class="r">${byT[k].n}</td><td class="r">${fmt(byT[k].t)}</td></tr>`))}</div><div class="card"><h3>खर्च वर्ग</h3>${tbl(['वर्ग','रकम|r'],Object.keys(byC).map(k=>`<tr><td>${esc(k)}</td><td class="r">${fmt(byC[k])}</td></tr>`))}</div></div>`}
  if(tab==='ledger'){
    const rows=[...D.pays.map(p=>({ts:p.at,k:'आम्दानी',d:p.no+' – '+(p.cust||''),m:p.method,a:num(p.amt)})),...D.exps.map(e=>({ts:Date.parse(e.date+'T12:00:00'),k:'खर्च',d:e.cat+(e.note?' – '+e.note:''),m:e.method,a:-num(e.amt)}))].sort((a,b)=>b.ts-a.ts);
    window.LEDGER=rows;
    return `<div class="row"><button class="btn bs" onclick="exportCSV('ledger')">⬇️ CSV</button><span class="mut">आम्दानी ${fmt(recv)} − खर्च ${fmt(expT)} = <b>${fmt(recv-expT)}</b></span></div>`+tbl(['मिति','प्रकार','विवरण','माध्यम','रकम|r'],rows.map(r=>`<tr><td>${tf(r.ts)}</td><td><span class="badge ${r.a>=0?'b-green':'b-red'}">${r.k}</span></td><td>${esc(r.d)}</td><td>${r.m==='online'?'अनलाइन':'नगद'}</td><td class="r">${fmt(Math.abs(r.a))}</td></tr>`))}
  if(tab==='purch'){
    return `<p class="mut">कुल खरिद: <b>${fmt(purchT)}</b> · तिरेको: <b>${fmt(D.purch.reduce((s,p)=>s+paidOf(p),0))}</b> · बाँकी: <b style="color:var(--er)">${fmt(purchT-D.purch.reduce((s,p)=>s+paidOf(p),0))}</b></p>`+tbl(['नं.','मिति','सप्लायर','बिल नं.','कुल|r','तिरेको|r','बाँकी|r'],D.purch.sort((a,b)=>b.date.localeCompare(a.date)).map(p=>`<tr class="clk" onclick="detail('purchases','${p.id}')"><td>${esc(p.no)}</td><td>${esc(p.date)}</td><td>${esc(p.supplierName)}</td><td>${esc(p.billNo||'-')}</td><td class="r">${fmt(p.total)}</td><td class="r">${fmt(paidOf(p))}</td><td class="r">${fmt(num(p.total)-paidOf(p))}</td></tr>`),'खरिद छैन')}
  if(tab==='udhar'){
    const g={};D.all.forEach(b=>{const d=num(b.total)-paidOf(b);if(d>0){const k=b.customerId||b.customerName||'—';(g[k]=g[k]||{name:b.customerName||'अज्ञात',phone:b.phone,id:b.customerId,n:0,d:0}).n++;g[k].d+=d}});
    const a=Object.values(g).sort((x,y)=>y.d-x.d);
    return `<p class="mut">कुल: <b>${fmt(a.reduce((s,x)=>s+x.d,0))}</b></p>`+tbl(['ग्राहक','फोन','बिल','बाँकी|r'],a.map(x=>`<tr class="${x.id?'clk':''}" ${x.id?`onclick="custDetail('${x.id}')"`:''}><td>${esc(x.name)}</td><td>${esc(x.phone||'')}</td><td>${x.n}</td><td class="r">${fmt(x.d)}</td></tr>`),'उधारो छैन')}
  if(tab==='exp')return `<div class="row"><button class="btn bp" onclick="expForm()">＋ नयाँ खर्च</button><span class="mut">कुल: <b>${fmt(expT)}</b></span></div>`+tbl(['मिति','वर्ग','विवरण','माध्यम','स्टाफ','रकम|r',''],D.exps.sort((a,b)=>b.date.localeCompare(a.date)).map(e=>`<tr><td>${esc(e.date)}</td><td>${esc(e.cat)}</td><td>${esc(e.note||'')}</td><td>${e.method==='online'?'अनलाइन':'नगद'}</td><td>${esc(e.byName||'')}</td><td class="r">${fmt(e.amt)}</td><td><button class="btn bs" onclick="expForm('${e.id}')">✏️</button> <button class="btn bs bd" onclick="delExp('${e.id}')">🗑️</button></td></tr>`));
  if(tab==='staff'){
    const rows=list('users').map(u=>{const mine=D.bills.filter(b=>b.by===u.id);const cnt=k=>mine.filter(b=>b.type===k).length;const pages=mine.filter(b=>b.type==='print').reduce((s,b)=>s+num(b.pages),0);const rc=D.pays.filter(p=>p.by===u.id).reduce((s,p)=>s+num(p.amt),0);const purchCount=list('purchases').filter(p=>p.by===u.id&&inR(Date.parse(p.date+'T12:00:00'),R)).length;return `<tr><td>${esc(u.name)} <span class="mut">(${u.role==='admin'?'एडमिन':'स्टाफ'})</span></td><td>${purchCount}</td><td>${cnt('print')} <span class="mut">(${pages} पाना)</span></td><td>${cnt('service')}</td><td>${cnt('form')}</td><td>${cnt('doc')}</td><td>${cnt('pos')}</td><td class="r">${fmt(mine.reduce((s,b)=>s+num(b.total),0))}</td><td class="r">${fmt(rc)}</td></tr>`});
    return tbl(['स्टाफ','खरिद','प्रिन्ट','सेवा','फाराम','निवेदन','POS','बिल रकम|r','प्राप्त|r'],rows)}
  return '';
}
function exportCSV(k){
  if(ME.role!=='admin'){toast('अनुमति छैन','err');return}
  let rows=[],name=k+'.csv';
  if(k==='ledger'){rows=[['मिति','प्रकार','विवरण','माध्यम','रकम']];(window.LEDGER||[]).forEach(r=>rows.push([tf(r.ts),r.k,r.d,r.m,r.a]))}
  if(k==='bills'){rows=[['बिल नं','प्रकार','मिति','ग्राहक','फोन','विवरण','कुल','छुट','प्राप्त','बाँकी','स्थिति','स्टाफ']];allBills().sort((a,b)=>a.createdAt-b.createdAt).forEach(b=>rows.push([b.no,TY[b.type][0],dOf(b.createdAt),b.customerName,b.phone,b.type==='pos'?(b.lines||[]).map(l=>l.name+'×'+l.qty).join('; '):jobTitle(b),b.total,b.discount||0,paidOf(b),num(b.total)-paidOf(b),ST[b.status]?ST[b.status][0]:'',b.byName]))}
  if(k==='purchases'){rows=[['खरिद नं','मिति','सप्लायर','बिल नं','कुल','तिरेको','बाँकी','स्टाफ']];list('purchases').forEach(p=>rows.push([p.no,p.date,p.supplierName,p.billNo||'',p.total,paidOf(p),num(p.total)-paidOf(p),p.byName||'']))}
  if(k==='sales'){rows=[['बिल नं','मिति','ग्राहक','सामान','कुल','प्राप्त','बाँकी','स्टाफ']];list('sales').forEach(s=>rows.push([s.no,dOf(s.createdAt),s.customerName||'',(s.lines||[]).map(l=>l.name+'×'+l.qty).join('; '),s.total,paidOf(s),num(s.total)-paidOf(s),s.byName||'']))}
  if(k==='suppliers'){rows=[['नाम','फोन','ठेगाना','PAN']];list('suppliers').forEach(s=>rows.push([s.name,s.phone,s.addr,s.pan]))}
  if(k==='expenses'){rows=[['मिति','वर्ग','विवरण','माध्यम','रकम','स्टाफ']];list('expenses').sort((a,b)=>a.date.localeCompare(b.date)).forEach(e=>rows.push([e.date,e.cat,e.note,e.method,e.amt,e.byName]))}
  if(k==='customers'){rows=[['नाम','फोन','ठेगाना','कैफियत']];list('customers').forEach(c=>rows.push([c.name,c.phone,c.addr,c.note]))}
  if(k==='stock'){rows=[['सामान','वर्ग','स्टक','एकाइ','खरिद मूल्य','बिक्री मूल्य']];list('items').forEach(i=>rows.push([i.name,i.cat,i.qty,i.unit,i.cost,i.price]))}
  if(k==='stockLedger'){rows=[['मिति','प्रकार','सामान','परिवर्तन','दर','बिल','पक्ष']];const ev=[];list('purchases').forEach(p=>(p.lines||[]).forEach(l=>ev.push({date:p.date,ts:Date.parse(p.date+'T12:00:00'),type:'खरिद',name:l.name,qty:l.qty,rate:l.rate,ref:p.no,party:p.supplierName})));list('sales').forEach(s=>(s.lines||[]).forEach(l=>ev.push({date:dOf(s.createdAt),ts:s.createdAt,type:'बिक्री',name:l.name,qty:-l.qty,rate:l.rate,ref:s.no,party:s.customerName})));ev.sort((a,b)=>a.ts-b.ts).forEach(e=>rows.push([e.date,e.type,e.name,e.qty,e.rate,e.ref,e.party]))}
  dl(name,csv(rows))
}

