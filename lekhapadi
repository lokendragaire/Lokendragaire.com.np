PAGES.salesReg={title:'बिक्री रजिस्टर',html(){return `<div class="row"><input class="grow" placeholder="बिल / ग्राहक" value="${esc(fget('salesReg','q',''))}" oninput="setF('salesReg','q',this.value)"><select onchange="setF('salesReg','per',this.value)">${opts(PERS,fget('salesReg','per','month'))}</select><select onchange="setF('salesReg','paid',this.value)"><option value="">सबै</option><option value="1" ${fget('salesReg','paid','')==='1'?'selected':''}>बाँकी</option></select></div><div id="lst"></div>`},
list(){const q=fget('salesReg','q','').toLowerCase(),per=fget('salesReg','per','month'),onlyPaid=fget('salesReg','paid','')==='1';let a=allBills().filter(b=>inPer(b.createdAt,per)&&(!q||(b.no+' '+(b.customerName||'')).toLowerCase().includes(q)));if(onlyPaid)a=a.filter(b=>num(b.total)-paidOf(b)>0);a.sort((x,y)=>y.createdAt-x.createdAt);const tot=a.reduce((s,b)=>s+num(b.total),0),pd=a.reduce((s,b)=>s+paidOf(b),0);return `<p class="mut">${a.length} बिल · कुल ${fmt(tot)} · प्राप्त ${fmt(pd)} · बाँकी ${fmt(tot-pd)}</p>`+tbl(['नं.','प्रकार','मिति','ग्राहक','कुल|r','प्राप्त|r','बाँकी|r',''],a.map(b=>`<tr class="clk" onclick="detail('${b._col}','${b.id}')"><td>${esc(b.no)}</td><td>${TY[b.type||'pos'][2]} ${TY[b.type||'pos'][0]}</td><td>${tf(b.createdAt)}</td><td>${esc(b.customerName||'-')}</td><td class="r">${fmt(b.total)}</td><td class="r">${fmt(paidOf(b))}</td><td class="r" style="color:${num(b.total)-paidOf(b)>0?'var(--er)':'var(--ok)'}">${fmt(num(b.total)-paidOf(b))}</td><td><button class="btn bs" onclick="event.stopPropagation();printReceipt('${b._col}','${b.id}')">🖨️</button></td></tr>`))}};

/* --- Profit (admin) --- */
PAGES.profit={title:'नाफा रिपोर्ट',html(){const per=fget('profit','per','month');return `<div class="row"><select onchange="setF('profit','per',this.value,true)">${opts(PERS,per)}</select></div>${profitBody(per)}`}};
function profitBody(per){
  const bills=allBills().filter(b=>inPer(b.createdAt,per));
  const purch=list('purchases').filter(p=>inPer(Date.parse(p.date+'T12:00:00'),per));
  const ex=list('expenses').filter(e=>{const t=Date.parse(e.date+'T12:00:00');return inPer(t,per)&&!e.ref});
  const sales=bills.reduce((s,b)=>s+num(b.total),0);
  const cogs=bills.filter(b=>b.type==='pos').reduce((s,b)=>s+(b.lines||[]).reduce((q,l)=>q+num(l.cost)*num(l.qty),0),0);
  const exT=ex.reduce((s,e)=>s+num(e.amt),0);
  const gp=sales-cogs,net=gp-exT;
  const itemMap={};
  bills.filter(b=>b.type==='pos').forEach(b=>(b.lines||[]).forEach(l=>{const k=l.itemId||l.name;(itemMap[k]=itemMap[k]||{name:l.name,qty:0,sales:0,cost:0});itemMap[k].qty+=num(l.qty);itemMap[k].sales+=num(l.qty)*num(l.rate);itemMap[k].cost+=num(l.qty)*num(l.cost||0)}));
  return `<div class="stats">
    <div class="stat"><span>कुल बिक्री</span><b>${fmt(sales)}</b></div>
    <div class="stat"><span>COGS</span><b>${fmt(cogs)}</b></div>
    <div class="stat"><span>Gross Profit</span><b style="color:${gp>=0?'var(--ok)':'var(--er)'}">${fmt(gp)}</b></div>
    <div class="stat"><span>सञ्चालन खर्च</span><b>${fmt(exT)}</b></div>
    <div class="stat"><span>Net Profit</span><b style="color:${net>=0?'var(--ok)':'var(--er)'}">${fmt(net)}</b></div>
    <div class="stat"><span>खरिद</span><b>${fmt(purch.reduce((s,p)=>s+num(p.total),0))}</b></div>
  </div>
  <div class="g2"><div class="card"><h3>सामान अनुसार</h3>${tbl(['सामान','परि.|r','बिक्री|r','लागत|r','नाफा|r'],Object.values(itemMap).sort((a,b)=>(b.sales-b.cost)-(a.sales-a.cost)).map(x=>`<tr><td>${esc(x.name)}</td><td class="r">${x.qty}</td><td class="r">${fmt(x.sales)}</td><td class="r">${fmt(x.cost)}</td><td class="r" style="color:${x.sales-x.cost>=0?'var(--ok)':'var(--er)'}">${fmt(x.sales-x.cost)}</td></tr>`),'बिक्री छैन')}</div>
  <div class="card"><h3>बिल प्रकार</h3>${(()=>{const m={};bills.forEach(b=>{const k=b.type;(m[k]=m[k]||{n:0,t:0}).n++;m[k].t+=num(b.total)});return tbl(['प्रकार','बिल|r','रकम|r'],Object.keys(m).map(k=>`<tr><td>${TY[k][2]} ${TY[k][0]}</td><td class="r">${m[k].n}</td><td class="r">${fmt(m[k].t)}</td></tr>`))})()}</div></div>`;
}

/* --- Customers --- */
function custForm(id){
  const c=id?DB.customers[id]:{};
  openModal(id?'ग्राहक सच्याउने':'नयाँ ग्राहक',()=>`<form id="mf" onsubmit="return false"><label>नाम *</label><input name="name" value="${esc(c.name||'')}"><label>फोन</label><input name="phone" value="${esc(c.phone||'')}"><label>ठेगाना</label><input name="addr" value="${esc(c.addr||'')}"><label>कैफियत</label><textarea name="note">${esc(c.note||'')}</textarea><div class="foot"><button type="button" class="btn" onclick="closeModal()">रद्द</button><button type="button" class="btn bp" onclick="saveCust('${id||''}')">सेभ</button></div></form>`,{sticky:true,doing:'ग्राहक दर्ता गर्दै'});
}
function saveCust(id){const n=V('name').trim();if(!n){toast('नाम','err');return}const c=id?DB.customers[id]:{createdAt:now(),by:ME.id,byName:ME.name};const o=put('customers',Object.assign({},c,{name:n,phone:V('phone').trim(),addr:V('addr').trim(),note:V('note')}));log(id?'update':'create',(id?'ग्राहक सच्यायो: ':'नयाँ ग्राहक: ')+n,{col:'customers',id:o.id});closeModal();toast('सेभ','ok')}
function custDetail(id){openModal('ग्राहक विवरण',()=>{const c=DB.customers[id];if(!c)return '<p class="mut">भेटिएन</p>';const bs=allBills().filter(b=>b.customerId===id||(b.customerName===c.name&&(!c.phone||b.phone===c.phone))).sort((a,b)=>b.createdAt-a.createdAt);const adm=ME.role==='admin';const due=bs.reduce((s,b)=>s+Math.max(0,num(b.total)-paidOf(b)),0);return `<p><b>${esc(c.name)}</b><br>📞 ${esc(c.phone||'-')} · 📍 ${esc(c.addr||'-')}<br>${nl(c.note)}</p>${adm?`<p>कुल बिल: <b>${bs.length}</b> · बाँकी: <b>${fmt(due)}</b></p>`:''}${tbl(['नं.','मिति','विवरण',...(adm?['कुल|r','बाँकी|r']:[])],bs.map(b=>`<tr class="clk" onclick="detail('${b._col}','${b.id}')"><td>${b.no}</td><td>${tf(b.createdAt)}</td><td>${esc(b.type==='pos'?(b.lines||[]).map(l=>l.name).join(', '):jobTitle(b))}</td>${adm?`<td class="r">${fmt(b.total)}</td><td class="r">${fmt(Math.max(0,num(b.total)-paidOf(b)))}</td>`:''}</tr>`))}<div class="foot"><button class="btn" onclick="closeModal();custForm('${id}')">सच्याउने</button>${adm?`<button class="btn bd" onclick="delCust('${id}')">मेटाउने</button>`:''}</div>`},{live:true,wide:true})}
function delCust(id){if(!confirm('मेटाउने?'))return;const n=DB.customers[id].name;del('customers',id);log('delete','ग्राहक मेटायो: '+n);closeModal()}
PAGES.customers={title:'ग्राहकहरू',html(){return `<div class="row"><button class="btn bp" onclick="custForm()">＋ नयाँ ग्राहक</button><input class="grow" placeholder="नाम / फोन" value="${esc(fget('customers','q',''))}" oninput="setF('customers','q',this.value)"></div><div id="lst"></div>`},
list(){const q=fget('customers','q','').toLowerCase();const bills=allBills();const adm=ME.role==='admin';const a=list('customers').filter(c=>!q||(c.name+' '+(c.phone||'')).toLowerCase().includes(q)).sort((x,y)=>x.name.localeCompare(y.name));return tbl(['नाम','फोन','ठेगाना',...(adm?['बिल','बाँकी|r']:['']),],a.map(c=>{const bs=bills.filter(b=>b.customerId===c.id);const du=bs.reduce((s,b)=>s+Math.max(0,num(b.total)-paidOf(b)),0);return `<tr class="clk" onclick="custDetail('${c.id}')"><td>${esc(c.name)}</td><td>${esc(c.phone||'')}</td><td>${esc(c.addr||'')}</td>${adm?`<td>${bs.length}</td><td class="r">${du?fmt(du):'-'}</td>`:'<td></td>'}</tr>`}))}};

/* --- Jobs (service/print/form/doc) --- */
['service','print','form','doc'].forEach(t=>{
  PAGES[t]={title:{service:'नयाँ सेवा',print:'प्रिन्ट / फोटोकपी',form:'अनलाइन फाराम',doc:'निवेदन / पत्र'}[t],
  html(){return `<div class="row"><button class="btn bp" onclick="jobForm('${t}')">＋ नयाँ ${TY[t][0]}</button><input class="grow" placeholder="खोज्नुस्" value="${esc(fget(t,'q',''))}" oninput="setF('${t}','q',this.value)"><select onchange="setF('${t}','st',this.value)"><option value="">सबै</option>${opts(Object.keys(ST).map(k=>[k,ST[k][0]]),fget(t,'st',''))}</select><select onchange="setF('${t}','per',this.value)">${opts(PERS,fget(t,'per',t==='print'?'today':'all'))}</select></div><div id="lst"></div>`},
  list(){const q=fget(t,'q','').toLowerCase(),st=fget(t,'st',''),per=fget(t,'per',t==='print'?'today':'all');const adm=ME.role==='admin';
    const a=list('jobs').filter(j=>j.type===t&&(!st||j.status===st)&&inPer(j.createdAt,per)&&(!q||(j.no+' '+j.customerName+' '+(j.phone||'')+' '+jobTitle(j)).toLowerCase().includes(q))).sort((x,y)=>y.createdAt-x.createdAt);
    const tot=a.reduce((s,j)=>s+num(j.total),0),du=a.reduce((s,j)=>s+Math.max(0,num(j.total)-paidOf(j)),0);
    const head=['नं.','मिति','ग्राहक','विवरण','स्थिति','स्टाफ',...(adm?['कुल|r','बाँकी|r']:[''])];
    return (adm?`<p class="mut">${a.length} वटा · कुल ${fmt(tot)} · बाँकी ${fmt(du)}</p>`:`<p class="mut">${a.length} वटा</p>`)+tbl(head,a.map(j=>{const d=Math.max(0,num(j.total)-paidOf(j));return `<tr class="clk" onclick="detail('jobs','${j.id}')"><td>${esc(j.no)}</td><td>${tf(j.createdAt)}</td><td>${esc(j.customerName)}</td><td>${esc(jobTitle(j))}</td><td><span class="badge ${ST[j.status]?ST[j.status][1]:''}">${ST[j.status]?ST[j.status][0]:''}</span></td><td>${esc(j.byName||'')}</td>${adm?`<td class="r">${fmt(j.total)}</td><td class="r">${d?fmt(d):'-'}</td>`:'<td></td>'}</tr>`}))}};
});

function jobForm(type,id){
  const ed=id?DB.jobs[id]:null;
  if(ed&&!canEdit(ed)){toast('सच्याउने अनुमति छैन','err');return}
  const s=S(),j=ed?clone(ed):{};
  let lines=(j.lines&&j.lines.length)?j.lines:(type==='print'?[{name:'',qty:1,rate:0}]:[]);
  let paidDirty=false;
  FM={vals:j.vals||{}};
  const label={service:'सेवा अर्डर',print:'प्रिन्ट बिल',form:'अनलाइन फाराम',doc:'निवेदन/पत्र'}[type];
  let extra='';
  if(type==='print')extra=`<label>छिटो थप्नुस्</label><div class="chips">${s.rates.map((r,i)=>`<span class="chip" onclick="FM.add(${i})">${esc(r.n)} · ${r.r}</span>`).join('')}</div><div class="tw"><table class="cart"><thead><tr><th>विवरण</th><th>परि.</th><th>दर</th><th class="r">रकम</th><th></th></tr></thead><tbody id="lines"></tbody></table></div><button type="button" class="btn bs" onclick="FM.blank()">+ लाइन</button>`;
  if(type==='service')extra=`<div class="g2"><div><label>सेवाको प्रकार</label><input name="svcType" list="svl" value="${esc(j.svcType||'')}"><datalist id="svl">${s.svcTypes.map(x=>`<option value="${esc(x)}">`).join('')}</datalist></div><div><label>शुल्क</label><input name="charge" type="number" step="any" value="${j.charge==null?'':j.charge}" oninput="FM.calc()"></div></div><label>विवरण</label><textarea name="desc">${esc(j.desc||'')}</textarea>`;
  if(type==='form')extra=`<div class="g2"><div><label>फाराम प्रकार</label><input name="formType" list="fml" value="${esc(j.formType||'')}"><datalist id="fml">${s.formTypes.map(x=>`<option value="${esc(x)}">`).join('')}</datalist></div><div><label>आवेदक</label><input name="applicant" value="${esc(j.applicant||'')}"></div><div><label>साइट</label><input name="site" value="${esc(j.site||'')}"></div><div><label>दर्ता नं.</label><input name="ref" value="${esc(j.ref||'')}"></div><div><label>सरकारी शुल्क</label><input name="govFee" type="number" step="any" value="${j.govFee==null?'':j.govFee}" oninput="FM.calc()"></div><div><label>सेवा शुल्क</label><input name="svcFee" type="number" step="any" value="${j.svcFee==null?'':j.svcFee}" oninput="FM.calc()"></div></div><label>पोर्टल लिंक</label><div class="chips">${list('links').map(l=>`<a class="chip" href="${esc(safeUrl(l.url))}" target="_blank" rel="noopener" onclick="setSite('${esc(l.id)}')" style="text-decoration:none">${esc(l.title)}</a>`).join('')}</div><label>टिप्पणी</label><textarea name="desc">${esc(j.desc||'')}</textarea>`;
  if(type==='doc'){const d=j.doc||{};extra=`<div class="g2"><div><label>ढाँचा</label><select name="tpl" onchange="FM.tpl(this.value)"><option value="">— खाली —</option>${opts(list('templates').map(t=>[t.id,t.name]),j.tplId||'')}</select></div><div><label>मिति (वि.सं.)</label><input name="dateBS" value="${esc(d.date||localStorage.getItem('shopmgr_bs')||'')}"></div></div><div id="ph" class="g2"></div><label>प्रति</label><textarea name="dto">${esc(d.to||'')}</textarea><label>विषय</label><input name="dsub" value="${esc(d.subject||'')}"><label>मुख्य पाठ</label><textarea name="dbody" style="min-height:150px">${esc(d.body||'')}</textarea><label>हस्ताक्षर</label><textarea name="dsign">${esc(d.sign||'')}</textarea><label>शुल्क</label><input name="fee" type="number" step="any" value="${j.fee==null?'':j.fee}" oninput="FM.calc()">`}
  const body=()=>`<form id="mf" onsubmit="return false"><datalist id="cdl">${list('customers').map(c=>`<option value="${esc(c.name)}">`).join('')}</datalist>
  <div class="g2"><div><label>ग्राहक *</label><input name="cname" list="cdl" value="${esc(j.customerName||'')}" oninput="FM.cpick()"></div><div><label>फोन</label><input name="phone" value="${esc(j.phone||'')}"></div></div>
  ${extra}
  <div class="g2"><div><label>छुट</label><input name="discount" type="number" step="any" value="${j.discount||''}" oninput="FM.calc()"></div><div><label>Deadline</label><input name="due" type="date" value="${esc(j.due||'')}"></div></div>
  <div class="card" style="background:#f6f8fb;margin-top:10px">उप-जम्मा: <b id="fsub">0</b> · <span class="big" id="ftot">0</span></div>
  ${ed?`<p class="mut">भुक्तानी: ${fmt(paidOf(ed))}</p>`:`<div class="g2"><div><label>अहिले प्राप्त</label><input name="paid" type="number" step="any" oninput="FM.pd()"></div><div><label>माध्यम</label><select name="method">${opts(PAYM.filter(x=>x[0]!=='credit'),'cash')}</select></div></div>`}
  <div class="g2"><div><label>स्थिति</label><select name="status">${opts(Object.keys(ST).map(k=>[k,ST[k][0]]),j.status||(type==='print'?'delivered':'pending'))}</select></div><div><label>कैफियत</label><input name="note" value="${esc(j.note||'')}"></div></div>
  <div class="foot"><button type="button" class="btn" onclick="closeModal()">रद्द</button><button type="button" class="btn bp" onclick="FM.save()">💾 सेभ</button></div></form>`;
  FM.rows=()=>{const e=$('#lines');if(!e)return;e.innerHTML=lines.map((l,i)=>`<tr><td><input value="${esc(l.name)}" oninput="FM.ln(${i},'name',this.value)"></td><td style="width:66px"><input type="number" step="any" value="${l.qty}" oninput="FM.ln(${i},'qty',this.value)"></td><td style="width:76px"><input type="number" step="any" value="${l.rate}" oninput="FM.ln(${i},'rate',this.value)"></td><td class="r" id="la${i}">${num(l.qty)*num(l.rate)}</td><td><button type="button" class="btn bs bd" onclick="FM.del(${i})">✕</button></td></tr>`).join('')};
  FM.ln=(i,k,v)=>{lines[i][k]=k==='name'?v:num(v);const a=$('#la'+i);if(a)a.textContent=num(lines[i].qty)*num(lines[i].rate);FM.calc()};
  FM.add=i=>{const r=s.rates[i];const f=lines.find(l=>l.name===r.n&&num(l.rate)===num(r.r));if(f)f.qty=num(f.qty)+1;else{if(lines.length===1&&!lines[0].name&&!num(lines[0].rate))lines=[];lines.push({name:r.n,qty:1,rate:r.r})}FM.rows();FM.calc()};
  FM.blank=()=>{lines.push({name:'',qty:1,rate:0});FM.rows()};
  FM.del=i=>{lines.splice(i,1);FM.rows();FM.calc()};
  FM.sub=()=>type==='print'?lines.reduce((a,l)=>a+num(l.qty)*num(l.rate),0):type==='service'?num(V('charge')):type==='doc'?num(V('fee')):num(V('govFee'))+num(V('svcFee'));
  FM.total=()=>Math.max(0,FM.sub()-num(V('discount')));
  FM.calc=()=>{const sub=FM.sub(),t=FM.total();const a=$('#fsub'),b=$('#ftot');if(a)a.textContent=fmt(sub);if(b)b.textContent=fmt(t);const pe=$('#mf [name="paid"]');if(pe&&!paidDirty)pe.value=t||''};
  FM.pd=()=>{paidDirty=true};
  FM.cpick=()=>{const n=V('cname').trim().toLowerCase();const c=list('customers').find(x=>x.name.trim().toLowerCase()===n);const pe=$('#mf [name="phone"]');if(c&&pe&&!pe.value)pe.value=c.phone||''};
  FM.fill=(t,v)=>String(t||'').replace(/\{\{\s*([^}]+?)\s*\}\}/g,(m,k)=>(v[k]&&String(v[k]).trim())?v[k]:'………');
  FM.keys=t=>{const set=[];[t.to,t.subject,t.body,t.sign].join('\n').replace(/\{\{\s*([^}]+?)\s*\}\}/g,(m,k)=>{if(k!=='नाम'&&k!=='फोन'&&!set.includes(k))set.push(k);return m});return set};
  FM.gen=()=>{const t=DB.templates[V('tpl')];if(!t)return;const v=Object.assign({'नाम':V('cname'),'फोन':V('phone')},FM.vals);const set=(n,val)=>{const e=$('#mf [name="'+n+'"]');if(e)e.value=val};set('dto',FM.fill(t.to,v));set('dsub',FM.fill(t.subject,v));set('dbody',FM.fill(t.body,v));set('dsign',FM.fill(t.sign,v))};
  FM.tpl=id=>{const t=DB.templates[id];const ph=$('#ph');if(!t){if(ph)ph.innerHTML='';return}ph.innerHTML=FM.keys(t).map(k=>`<div><label>${esc(k)}</label><input value="${esc(FM.vals[k]||'')}" oninput="FM.setv(this.dataset.k,this.value)" data-k="${esc(k)}"></div>`).join('');FM.gen()};
  FM.setv=(k,v)=>{FM.vals[k]=v;FM.gen()};
  FM.save=()=>{
    const cname=V('cname').trim();if(!cname){toast('ग्राहकको नाम','err');return}
    if(type==='print'){lines=lines.filter(l=>l.name.trim()||num(l.rate));if(!lines.length){toast('कम्तीमा एउटा','err');return}}
    const o=ed?Object.assign({},ed):{type,payments:[],comments:[],createdAt:now(),by:ME.id,byName:ME.name};
    o.customerName=cname;o.phone=V('phone').trim();o.customerId=ensureCust(cname,o.phone);
    if(type==='print'){o.lines=clone(lines);o.pages=lines.reduce((a,l)=>a+num(l.qty),0)}
    if(type==='service'){o.svcType=V('svcType');o.charge=num(V('charge'));o.desc=V('desc')}
    if(type==='form'){o.formType=V('formType');o.applicant=V('applicant');o.site=V('site');o.ref=V('ref');o.govFee=num(V('govFee'));o.svcFee=num(V('svcFee'));o.desc=V('desc')}
    if(type==='doc'){o.tplId=V('tpl');o.vals=clone(FM.vals);o.fee=num(V('fee'));o.doc={date:V('dateBS'),to:V('dto'),subject:V('dsub'),body:V('dbody'),sign:V('dsign')};o.title=o.doc.subject;try{localStorage.setItem('shopmgr_bs',V('dateBS'))}catch(e){}}
    o.discount=num(V('discount'));o.total=FM.total();o.status=V('status');o.due=V('due');o.note=V('note');
    if(!ed){o.no=nextNo(type);const p=num(V('paid'));if(p>0)o.payments.push({amt:p,method:V('method'),at:now(),by:ME.id,byName:ME.name})}
    put('jobs',o);log(ed?'update':'create',`${o.no} ${TY[type][0]} ${ed?'सच्यायो':'बनायो'} – ${cname} (${fmt(o.total)})`,{col:'jobs',id:o.id});
    closeModal();toast('सेभ: '+o.no,'ok');
    if(!ed&&type==='print'){if(confirm('रसिद प्रिन्ट गर्ने?'))printReceipt('jobs',o.id)}
    else if(!ed&&type==='doc')detail('jobs',o.id);
  };
  openModal((ed?'सच्याउने: '+ed.no:'नयाँ '+label),body,{sticky:true,wide:true,doing:(ed?'सच्याउँदै ':'नयाँ ')+label+(ed?' '+ed.no:' बनाउँदै')});
  if(type==='print')FM.rows();
  if(type==='doc'&&j.tplId){const t=DB.templates[j.tplId];if(t){$('#ph').innerHTML=FM.keys(t).map(k=>`<div><label>${esc(k)}</label><input value="${esc(FM.vals[k]||'')}" oninput="FM.setv(this.dataset.k,this.value)" data-k="${esc(k)}"></div>`).join('')}}
  FM.calc();
}

/* --- Bill detail — staff लाई आर्थिक कुरा लुकाउने --- */
function detail(col,id){
  if(ME.role!=='admin'&&(col==='purchases'||col==='sales')){toast('यो रेकर्ड हेर्ने अनुमति छैन','err');return}
  openModal('विवरण',()=>billBody(col,id),{live:true,wide:true})
}
function billBody(col,id){
  const b=DB[col][id];if(!b)return '<p class="mut">भेटिएन</p>';
  const adm=ME.role==='admin';
  if(!adm&&col!=='jobs')return '<p class="mut">अनुमति छैन</p>';
  const paid=paidOf(b),due=num(b.total)-paid;
  let body='';
  if(col==='purchases'){
    if(!adm)return '<p class="mut">अनुमति छैन</p>';
    body=`<p>सप्लायर: <b>${esc(b.supplierName||'-')}</b> · बिल: ${esc(b.billNo||'-')} · मिति: ${esc(b.date)}</p>`+tbl(['सामान','परि.|r','दर|r','रकम|r'],(b.lines||[]).map(l=>`<tr><td>${esc(l.name)}</td><td class="r">${l.qty}</td><td class="r">${l.rate}</td><td class="r">${fmt(num(l.qty)*num(l.rate))}</td></tr>`));
  } else {
    if(b.type==='print')body=tbl(['विवरण','परि.|r','दर|r','रकम|r'],(b.lines||[]).map(l=>`<tr><td>${esc(l.name)}</td><td class="r">${l.qty}</td><td class="r">${l.rate}</td><td class="r">${fmt(num(l.qty)*num(l.rate))}</td></tr>`));
    else if(b.type==='service')body=`<p><b>${esc(b.svcType)}</b><br>${nl(b.desc)}</p>`;
    else if(b.type==='form')body=`<p><b>${esc(b.formType)}</b> — ${esc(b.applicant||b.customerName)}<br>साइट: ${esc(b.site||'-')}<br>दर्ता: <b>${esc(b.ref||'-')}</b>${adm?'<br>सरकारी '+fmt(b.govFee)+' · सेवा '+fmt(b.svcFee):''}</p>`;
    else if(b.type==='doc'){const d=b.doc||{};body=`<p><b>${esc(d.subject)}</b> (${esc(d.date||'-')})</p><div class="card" style="background:#fafafa;white-space:pre-wrap">${esc(d.to)}\n\n${esc(d.body)}\n\n${esc(d.sign)}</div>`}
    if(b.type==='trans')body=`<p><b>${esc(trDocName(b))}</b></p><div class="card" style="background:#fafafa;white-space:pre-wrap">${esc(b.enDoc||b.enText||'')}</div>`;
  }
  const job=col==='jobs';
  const chips=job?`<div class="chips">${Object.keys(ST).map(k=>`<button type="button" class="chip" style="${b.status===k?'background:var(--p);color:#fff':''}" onclick="setStatus('${id}','${k}')">${ST[k][0]}</button>`).join('')}</div>`:'';
  const cms=(b.comments||[]).map(c=>`<div class="it" style="cursor:default"><b>${esc(c.byName)}</b> <span class="mut">${tf(c.at)}</span><br>${nl(c.text)}</div>`).join('');
  const title=col==='purchases'?`खरिद बिल ${b.no}`:`${TY[b.type||'pos'][2]} ${TY[b.type||'pos'][0]} ${b.no}`;

  let moneyBox='';
  if(adm){
    moneyBox=`<div class="card" style="margin-top:10px"><div class="g2"><div>उप-जम्मा: ${fmt(num(b.total)+num(b.discount||0))}<br>छुट: ${fmt(b.discount||0)}<br><b>कुल: ${fmt(b.total)}</b></div><div>प्राप्त: <b style="color:var(--ok)">${fmt(paid)}</b><br>बाँकी: <b style="color:${due>0?'var(--er)':'var(--ok)'}">${fmt(Math.max(0,due))}</b></div></div>
    ${(b.payments||[]).length?tbl(['मिति','रकम|r','माध्यम',''],(b.payments||[]).map((p,i)=>`<tr><td>${tf(p.at)}</td><td class="r">${fmt(p.amt)}</td><td>${p.method==='online'?'अनलाइन':'नगद'}</td><td><button type="button" class="btn bs bd" onclick="delPay('${col}','${id}',${i})">✕</button></td></tr>`)):''}
    <div class="row" style="margin-top:8px"><input id="pamt" type="number" step="any" placeholder="भुक्तानी" style="max-width:140px" value="${due>0?due:''}"><select id="pmeth" style="max-width:140px">${opts(PAYM.filter(x=>x[0]!=='credit'),'cash')}</select><button type="button" class="btn bg" onclick="addPay('${col}','${id}')">＋ भुक्तानी</button></div></div>`;
  }

  const footBtns=[];
  if(adm){
    if(col==='purchases'){footBtns.push(`<button class="btn" onclick="printPurchase('${id}')">🧾 खरिद बिल</button>`);footBtns.push(`<button class="btn" onclick="closeModal();purchaseForm('${id}')">✏️ सच्याउने</button>`)}
    else footBtns.push(`<button class="btn" onclick="printReceipt('${col}','${id}')">🧾 रसिद</button>`);
    if(b.type==='doc')footBtns.push(`<button class="btn" onclick="printDoc('${id}')">🖨️ निवेदन</button>`);
    if(b.type==='trans')footBtns.push(`<button class="btn" onclick="printTrans('${id}')">🖨️ अनुवाद</button>`);
    if(job&&b.type!=='trans'&&canEdit(b))footBtns.push(`<button class="btn" onclick="closeModal();jobForm('${b.type}','${id}')">✏️ सच्याउने</button>`);
    footBtns.push(`<button class="btn bd" onclick="${col==='purchases'?`delPurchase('${id}')`:`delBill('${col}','${id}')`}">🗑️ मेटाउने</button>`);
  } else {
    // स्टाफ: निवेदन प्रिन्ट र स्टेटस मात्र
    if(b.type==='doc')footBtns.push(`<button class="btn" onclick="printDoc('${id}')">🖨️ निवेदन प्रिन्ट</button>`);
    if(b.type==='trans')footBtns.push(`<button class="btn" onclick="printTrans('${id}')">🖨️ अनुवाद प्रिन्ट</button>`);
  }

  return `<div class="row"><b class="big">${esc(title)}</b><span class="mut">${tf(b.createdAt||Date.parse(b.date+'T12:00:00'))} · ${esc(b.byName||'')}</span></div>
  <p>${col==='purchases'?'🏭':'👤'} <b>${esc(b.supplierName||b.customerName||'-')}</b> ${b.phone?'· 📞 '+esc(b.phone):''} ${b.due?'· ⏰ '+esc(b.due):''}</p>
  ${chips}${body}
  ${moneyBox}
  <div class="foot" style="justify-content:flex-start">${footBtns.join('')}</div>
