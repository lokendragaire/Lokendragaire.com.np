/* refresh */
let SCH=0,PEND=false,PAGE='dash';const F={};
const fget=(p,k,d)=>{const o=F[p]||(F[p]={});return o[k]===undefined?d:o[k]};
function setF(p,k,v,full){(F[p]||(F[p]={}))[k]=v;if(full)renderPage();else{const pg=PAGES[p];if(pg.partial)pg.partial();else{const l=$('#lst');if(l&&pg.list)l.innerHTML=pg.list()}}}
function schedule(){clearTimeout(SCH);SCH=setTimeout(refresh,250)}
const typing=root=>{const a=document.activeElement;return a&&root&&root.contains(a)&&/INPUT|TEXTAREA|SELECT/.test(a.tagName)};
function refresh(){
  if(!ME)return;
  const u=DB.users[ME.id];if(!u||u.active===false){toast('खाता बन्द वा हटाइयो','err');logout();return}
  ME=u;
  // staff ले admin-only पेजमा पुगे भने redirect
  if(ME.role!=='admin'&&ADMIN_ONLY.includes(PAGE)){PAGE='dash';renderShell();return}
  const p=PAGES[PAGE];
  if(p){if(p.partial)p.partial();else if(p.list&&$('#lst'))$('#lst').innerHTML=p.list();else if(!typing($('#page')))renderPage();else PEND=true}
  if(MODAL&&MODAL.sync)MODAL.sync();
  if(MODAL&&MODAL.live&&!typing($('#modal'))&&$('#mbody'))$('#mbody').innerHTML=MODAL.bodyFn();
  renderBell();checkNew();
}
document.addEventListener('focusout',()=>{if(PEND){PEND=false;setTimeout(schedule,400)}});
let KNOWN=null,PREV={};
function bellItems(){return list('activity').filter(a=>a.by!==ME.id&&(ME.role==='admin'||a.to===ME.id)).sort((a,b)=>b.at-a.at)}
function checkNew(){
  const acts=list('activity');
  if(KNOWN===null){KNOWN=new Set(acts.map(a=>a.id));PREV={};liveList().forEach(p=>PREV[p.id]=p.doing);return}
  bellItems().forEach(a=>{if(!KNOWN.has(a.id)){toast(a.byName+' '+a.text);beep()}});
  acts.forEach(a=>KNOWN.add(a.id));
  liveList().forEach(p=>{if(p.doing&&PREV[p.id]!==p.doing){toast('🟢 '+p.name+': '+p.doing);beep()}PREV[p.id]=p.doing});
}

