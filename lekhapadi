 rates:[{n:'B/W प्रिन्ट A4',r:5},{n:'रंगीन प्रिन्ट A4',r:20},{n:'फोटोकपी A4',r:2},{n:'फोटोकपी A3',r:5},{n:'स्क्यान',r:10},{n:'लेमिनेसन A4',r:30}],
 svcTypes:['टाइपिङ','स्क्यान / PDF','लेमिनेसन','बाइन्डिङ','पासपोर्ट साइज फोटो','इमेल / अन्य'],
 formTypes:['राहदानी (Passport)','राष्ट्रिय परिचयपत्र','सवारी लाइसेन्स','PAN / कर','लोकसेवा आवेदन','विद्यालय/क्याम्पस भर्ना','नागरिकता/जन्मदर्ता','अन्य अनलाइन फाराम'],
