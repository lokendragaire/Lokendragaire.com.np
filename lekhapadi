let DB={},PRES={},cloud=false,fbdb=null,ONLINE=false,ME=null;
COLS.forEach(c=>DB[c]={});
const LS='shopmgr_db_v4';
const clean=o=>JSON.parse(JSON.stringify(o));
const list=c=>Object.values(DB[c]||{});
const S=()=>Object.assign({},DEF,DB.settings.main||{});
const clone=o=>JSON.parse(JSON.stringify(o));
function loadLocal(){try{const d=JSON.parse(localStorage.getItem(LS)||'null');if(d)COLS.forEach(c=>DB[c]=d[c]||{})}catch(e){}}
function saveLocal(){try{localStorage.setItem(LS,JSON.stringify(DB))}catch(e){toast('स्टोरेज भरियो','err')}}
function fberr(e){console.error(e);toast('सिंक त्रुटि: '+(e&&e.message||e),'err')}
function put(col,o){if(!o.id)o.id=uid();DB[col][o.id]=o;saveLocal();if(cloud)fbdb.ref('shop/'+col+'/'+o.id).set(clean(o)).catch(fberr);schedule();return o}
function del(col,id){delete DB[col][id];saveLocal();if(cloud)fbdb.ref('shop/'+col+'/'+id).remove().catch(fberr);schedule()}
function getCfg(){if(sessionStorage.getItem('shopmgr_nocloud'))return null;if(FIREBASE_CONFIG)return FIREBASE_CONFIG;try{return JSON.parse(localStorage.getItem('shopmgr_fbcfg')||'null')}catch(e){return null}}
function loadScript(src){return new Promise((res,rej)=>{const s=document.createElement('script');s.src=src;s.onload=res;s.onerror=()=>rej(new Error('script load: '+src));document.head.appendChild(s)})}
async function initCloud(cfg){
  const b='https://www.gstatic.com/firebasejs/10.12.2/';
  await loadScript(b+'firebase-app-compat.js');await loadScript(b+'firebase-auth-compat.js');await loadScript(b+'firebase-database-compat.js');
  firebase.initializeApp(cfg);
  try{await firebase.auth().signInAnonymously()}catch(e){console.warn('anon auth',e)}
  fbdb=firebase.database();cloud=true;
  fbdb.ref('.info/serverTimeOffset').on('value',s=>{OFFSET=s.val()||0});
  fbdb.ref('.info/connected').on('value',s=>{ONLINE=!!s.val();renderConn()});
  fbdb.ref('shop/presence').on('value',s=>{PRES=s.val()||{};schedule()});
  await Promise.all(COLS.map(c=>new Promise(res=>{let first=true;fbdb.ref('shop/'+c).on('value',s=>{DB[c]=s.val()||{};saveLocal();if(first){first=false;res()}else schedule()},e=>{fberr(e);if(first){first=false;res()}})})));
  return true;
}
function seed(){
  if(!list('users').length)put('users',{id:'u_admin',name:'एडमिन',username:'admin',pass:hash('admin123'),role:'admin',active:true,createdAt:now()});
  if(!DB.settings.main)put('settings',clone(DEF));
  const sd=S().seeded||[],miss=DEFT.filter(t=>!sd.includes(t.id));
  if(miss.length||!S().seedL){
    miss.forEach(t=>{if(!DB.templates[t.id])put('templates',clone(t))});
    if(!S().seedL)LINKS.forEach(l=>{if(!DB.links[l.id])put('links',clone(l))});
    put('settings',Object.assign({},S(),{id:'main',seeded:[...sd,...miss.map(t=>t.id)],seedL:true}));
  }
}

/* business helpers */
const paidOf=b=>(b.payments||[]).reduce((s,p)=>s+num(p.amt),0);
const allBills=()=>[...list('jobs').map(j=>Object.assign({},j,{_col:'jobs'})),...list('sales').map(s=>Object.assign({},s,{_col:'sales',type:'pos',status:'delivered'}))];
function nextNo(k){const pre={service:'S',print:'P',form:'F',doc:'D',trans:'T',sale:'B',purchase:'PU'}[k];const arr=k==='sale'?list('sales'):k==='purchase'?list('purchases'):list('jobs').filter(j=>j.type===k);let m=0;arr.forEach(x=>{const n=parseInt(String(x.no||'').split('-')[1]);if(n>m)m=n});return pre+'-'+String(m+1).padStart(4,'0')}
function inPer(ts,per){if(per==='all')return true;const d=dOf(ts),t=today();if(per==='today')return d===t;if(per==='week')return ts>=now()-7*864e5;if(per==='month')return d.slice(0,7)===t.slice(0,7);return true}
function jobTitle(j){if(j.type==='trans')return '🔤 '+trDocName(j);if(j.type==='print')return (j.lines||[]).map(l=>l.name+'×'+l.qty).join(', ');if(j.type==='service')return (j.svcType||'')+(j.desc?' – '+j.desc:'');if(j.type==='form')return (j.formType||'')+(j.ref?' ['+j.ref+']':'');return (j.doc&&j.doc.subject)||j.title||''}
function canEdit(r){return ME.role==='admin'||(r.by===ME.id&&dOf(r.createdAt)===today())}
function ensureCust(name,phone){name=(name||'').trim();phone=(phone||'').trim();if(!name)return '';const cs=list('customers');let c=cs.find(x=>phone&&x.phone===phone)||cs.find(x=>x.name.trim().toLowerCase()===name.toLowerCase()&&(!phone||!x.phone));if(!c){c=put('customers',{name,phone,addr:'',note:'',createdAt:now(),by:ME.id,byName:ME.name});log('create','नयाँ ग्राहक: '+name,{col:'customers',id:c.id})}return c.id}
function ensureSupplier(name,phone){name=(name||'').trim();if(!name)return '';const ss=list('suppliers');let s=ss.find(x=>phone&&x.phone===phone)||ss.find(x=>x.name.trim().toLowerCase()===name.toLowerCase());if(!s){s=put('suppliers',{name,phone,addr:'',pan:'',createdAt:now(),by:ME.id});log('create','नयाँ सप्लायर: '+name,{col:'suppliers',id:s.id})}return s.id}
function log(action,text,ref,to){put('activity',{at:now(),by:ME.id,byName:ME.name,role:ME.role,action,text,ref:ref||null,to:to||null});const a=list('activity');if(a.length>900)a.sort((x,y)=>x.at-y.at).slice(0,200).forEach(x=>del('activity',x.id))}
const toOwner=b=>(ME.role==='admin'&&b.by&&b.by!==ME.id)?b.by:null;

