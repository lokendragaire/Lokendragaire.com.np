/* --- Dashboard — स्टाफलाई आर्थिक कुरा देखिँदैन --- */
function dayStats(date){
  const bills=allBills().filter(b=>dOf(b.createdAt)===date);
  const rec={cash:0,online:0};allBills().forEach(b=>(b.payments||[]).forEach(p=>{if(dOf(p.at)===date)rec[p.method==='online'?'online':'cash']+=num(p.amt)}));
  const purch=list('purchases').filter(p=>p.date===date);
  const ex=list('expenses').filter(e=>e.date===date);
  const byType={};bills.forEach(b=>{byType[b.type]=(byType[b.type]||0)+1});
  return{bills,n:bills.length,billed:bills.reduce((s,b)=>s+num(b.total),0),rec,exCash:ex.filter(e=>e.method!=='online').reduce((s,e)=>s+num(e.amt),0),exAll:ex.reduce((s,e)=>s+num(e.amt),0),credit:bills.reduce((s,b)=>s+Math.max(0,num(b.total)-paidOf(b)),0),byType,purch,purchTotal:purch.reduce((s,p)=>s+num(p.total),0)};
}
