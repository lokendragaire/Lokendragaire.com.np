let cart=[];const POS={q:'',disc:'',cname:'',phone:'',method:'cash',paid:'',dirty:false};
PAGES.pos={title:'POS बिक्री',html(){return `<div class="pos"><div class="card"><div class="row"><input class="grow" id="posq" placeholder="सामान खोज्नुस्..." value="${esc(POS.q)}" oninput="POS.q=this.value;posList()"><button class="btn" onclick="posCustom()">+ अन्य</button></div><div class="prods" id="poslist"></div></div><div class="card" id="cart"></div></div>`},after(){posList();posCart()},partial(){posList()}};
function posList(){const q=POS.q.toLowerCase();const a=list('items').filter(i=>!q||(i.name+' '+(i.cat||'')).toLowerCase().includes(q)).sort((x,y)=>x.name.localeCompare(y.name));const e=$('#poslist');if(e)e.innerHTML=a.length?a.map(i=>`<div class="prod" onclick="posAdd('${i.id}')"><b>${esc(i.name)}</b><small>${fmt(i.price)} · स्टक ${i.qty}</small></div>`).join(''):'<p class="mut">सामान छैन</p>'}
function posAdd(id){const it=DB.items[id];if(!it)return;const l=cart.find(x=>x.itemId===id);if(l)l.qty=num(l.qty)+1;else cart.push({itemId:id,name:it.name,qty:1,rate:num(it.price),cost:num(it.cost)});posCart();pres({doing:'POS बिल बनाउँदै',draft:'POS: '+cart.map(l=>l.name+'×'+l.qty).join(', ')})}
function posCustom(){const n=prompt('सामानको नाम?');if(!n)return;const r=num(prompt('दर?'));cart.push({itemId:'',name:n,qty:1,rate:r,cost:0});posCart()}
const posSub=()=>cart.reduce((s,l)=>s+num(l.qty)*num(l.rate),0);
function posCart(){const e=$('#cart');if(!e)return;const adm=ME.role==='admin';e.innerHTML=`<h3>🧾 बिल</h3>${cart.length?`<div class="tw"><table class="cart"><thead><tr><th>सामान</th><th>परि.</th><th>दर</th><th class="r">रकम</th><th></th></tr></thead><tbody>${cart.map((l,i)=>`<tr><td>${esc(l.name)}</td><td style="width:70px"><input type="number" min="0" step="any" value="${l.qty}" oninput="cart[${i}].qty=num(this.value);posTot()"></td><td style="width:80px"><input type="number" min="0" step="any" value="${l.rate}" oninput="cart[${i}].rate=num(this.value);posTot()"></td><td class="r" id="pl${i}">${num(l.qty)*num(l.rate)}</td><td><button class="btn bs bd" onclick="cart.splice(${i},1);posCart()">✕</button></td></tr>`).join('')}</tbody></table></div>`:'<p class="mut">सामानमा क्लिक गरेर थप्नुस्</p>'}
<div class="g2"><div><label>ग्राहक</label><input value="${esc(POS.cname)}" oninput="POS.cname=this.value" list="cdl2"><datalist id="cdl2">${list('customers').map(c=>`<option value="${esc(c.name)}">`).join('')}</datalist></div><div><label>फोन</label><input value="${esc(POS.phone)}" oninput="POS.phone=this.value"></div><div><label>छुट</label><input type="number" step="any" value="${POS.disc}" oninput="POS.disc=this.value;posTot()"></div><div><label>माध्यम</label><select onchange="POS.method=this.value">${opts(PAYM,POS.method)}</select></div></div>
<div class="card" style="background:#f6f8fb;margin-top:10px">उप-जम्मा: <b id="psub">0</b> · कुल: <span class="big" id="ptot">0</span></div>
<label>प्राप्त</label><input id="ppaid" type="number" step="any" value="${POS.paid}" oninput="POS.paid=this.value;POS.dirty=true;posTot()"><p class="mut">बाँकी: <b id="pdue">0</b></p>
<div class="foot"><button class="btn" onclick="cart=[];POS.disc='';POS.paid='';POS.dirty=false;posCart()">खाली</button><button class="btn bg" onclick="posCheckout()">✅ बिल</button></div>`;posTot()}
function posTot(){cart.forEach((l,i)=>{const e=$('#pl'+i);if(e)e.textContent=num(l.qty)*num(l.rate)});const sub=posSub(),tot=Math.max(0,sub-num(POS.disc));const a=$('#psub'),b=$('#ptot'),c=$('#ppaid'),d=$('#pdue');if(a)a.textContent=fmt(sub);if(b)b.textContent=fmt(tot);if(c&&!POS.dirty){c.value=tot||'';POS.paid=c.value}if(d)d.textContent=fmt(Math.max(0,tot-num(c?c.value:0)));pres({draft:'POS: '+cart.map(l=>l.name+'×'+l.qty).join(', ')+' | कुल '+fmt(tot)})}
function posCheckout(){
  if(!cart.length){toast('सामान छान्नुस्','err');return}
  for(const l of cart){if(l.itemId){const it=DB.items[l.itemId];if(!it||num(it.qty)<num(l.qty)){toast('स्टक पुग्दैन: '+l.name,'err');return}}}
  const sub=posSub(),disc=num(POS.disc),total=Math.max(0,sub-disc),paid=num(POS.paid);
  const s={no:nextNo('sale'),lines:clone(cart),discount:disc,total,customerName:POS.cname.trim(),phone:POS.phone.trim(),payments:[],comments:[],createdAt:now(),by:ME.id,byName:ME.name};
  if(s.customerName)s.customerId=ensureCust(s.customerName,s.phone);
  if(paid>0)s.payments.push({amt:paid,method:POS.method==='credit'?'cash':POS.method,at:now(),by:ME.id,byName:ME.name});
  put('sales',s);
  cart.forEach(l=>{if(l.itemId){const it=DB.items[l.itemId];put('items',Object.assign({},it,{qty:num(it.qty)-num(l.qty)}))}});
  log('sale',`POS बिल ${s.no} (${fmt(total)}) — नाफा ${fmt(total-cart.reduce((x,l)=>x+num(l.cost)*num(l.qty),0))}`,{col:'sales',id:s.id});
  cart=[];POS.disc='';POS.paid='';POS.dirty=false;POS.cname='';POS.phone='';posCart();posList();pres({doing:'',draft:''});toast('बिल: '+s.no,'ok');
  if(ME.role==='admin'&&confirm('रसिद प्रिन्ट?'))printReceipt('sales',s.id);
}

