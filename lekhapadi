function importJSON(inp){const f=inp.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);if(!confirm('मर्ज गर्ने?'))return;let n=0;COLS.forEach(c=>Object.values(d[c]||{}).forEach(o=>{if(o&&o.id){put(c,o);n++}}));toast(n+' रेकर्ड','ok')}catch(e){toast('फाइल मिलेन','err')}};r.readAsText(f)}

