list(){const q=fget('suppliers','q','').toLowerCase();const ps=list('purchases');const a=list('suppliers').filter(s=>!q||(s.name+' '+(s.phone||'')).toLowerCase().includes(q)).sort((x,y)=>x.name.localeCompare(y.name));return tbl(['नाम','फोन','ठेगाना','खरिद बिल','कुल खरिद|r','बाँकी|r'],a.map(s=>{const mine=ps.filter(p=>p.supplierId===s.id);const tot=mine.reduce((x,p)=>x+num(p.total),0);const pd=mine.reduce((x,p)=>x+paidOf(p),0);return `<tr class="clk" onclick="supDetail('${s.id}')"><td><b>${esc(s.name)}</b></td><td>${esc(s.phone||'')}</td><td>${esc(s.addr||'')}</td><td>${mine.length}</td><td class="r">${fmt(tot)}</td><td class="r" style="color:${tot-pd>0?'var(--er)':'var(--ok)'}">${fmt(tot-pd)}</td></tr>`}))}};

/* --- Purchase (admin only) --- */
function purchaseForm(id){
  const ed=id?DB.purchases[id]:null;
  const p=ed?clone(ed):{date:today(),lines:[],discount:0,paid:0,method:'cash'};
  let lines=(p.lines&&p.lines.length)?p.lines:[{itemId:'',name:'',qty:1,rate:0}];
  let paidDirty=ed?true:false;
  const body=()=>`<form id="mf" onsubmit="return false">
    <div class="g3">
      <div><label>मिति *</label><input name="date" type="date" value="${esc(p.date)}"></div>
      <div><label>सप्लायर *</label><input name="supplierName" list="supdl" value="${esc(p.supplierName||'')}"><datalist id="supdl">${list('suppliers').map(s=>`<option value="${esc(s.name)}">`).join('')}</datalist></div>
      <div><label>बिल नं.</label><input name="billNo" value="${esc(p.billNo||'')}"></div>
    </div>
    <label>सामान</label>
    <div class="tw"><table class="cart"><thead><tr><th>सामान</th><th>परिमाण</th><th>खरिद दर</th><th class="r">रकम</th><th></th></tr></thead><tbody id="plines"></tbody></table></div>
    <div class="row" style="margin-top:6px"><button type="button" class="btn bs" onclick="PF.blank()">+ लाइन</button><button type="button" class="btn bs" onclick="PF.newItemPrompt()">+ नयाँ सामान</button></div>
    <div class="g3" style="margin-top:10px">
      <div><label>छुट</label><input name="discount" type="number" step="any" value="${p.discount||''}" oninput="PF.calc()"></div>
      <div><label>तिरेको</label><input name="paid" type="number" step="any" value="${p.paid||''}" oninput="PF.pd()"></div>
      <div><label>माध्यम</label><select name="method">${opts(PAYM.filter(x=>x[0]!=='credit'),p.method||'cash')}</select></div>
    </div>
    <div class="card" style="background:#f6f8fb;margin-top:10px">उप-जम्मा: <b id="psub">0</b> · <span class="big" id="ptot">0</span> · बाँकी: <b id="pdiff">0</b></div>
    <label><input type="checkbox" name="addStock" style="width:auto" ${ed?'':'checked'}> स्टकमा थप्ने</label>
    <label>कैफियत</label><input name="note" value="${esc(p.note||'')}">
    <div class="foot"><button type="button" class="btn" onclick="closeModal()">रद्द</button><button type="button" class="btn bp" onclick="PF.save()">💾 सेभ</button></div>
  </form>`;
  const PF={
    rows:()=>{const e=$('#plines');if(!e)return;e.innerHTML=lines.map((l,i)=>`<tr>
      <td><input list="itemdl" value="${esc(l.name)}" oninput="PF.ln(${i},'name',this.value)" onchange="PF.match(${i},this.value)"></td>
      <td style="width:80px"><input type="number" step="any" value="${l.qty}" oninput="PF.ln(${i},'qty',this.value)"></td>
      <td style="width:90px"><input type="number" step="any" value="${l.rate}" oninput="PF.ln(${i},'rate',this.value)"></td>
      <td class="r" id="pla${i}">${num(l.qty)*num(l.rate)}</td>
      <td><button type="button" class="btn bs bd" onclick="PF.del(${i})">✕</button></td>
    </tr>`).join('')},
    ln:(i,k,v)=>{lines[i][k]=k==='name'?v:num(v);const a=$('#pla'+i);if(a)a.textContent=num(lines[i].qty)*num(lines[i].rate);PF.calc()},
    match:(i,v)=>{const it=list('items').find(x=>x.name.toLowerCase()===String(v).trim().toLowerCase());if(it){lines[i].itemId=it.id;if(!num(lines[i].rate))lines[i].rate=num(it.cost);PF.rows();PF.calc()}},
    blank:()=>{lines.push({itemId:'',name:'',qty:1,rate:0});PF.rows()},
    del:i=>{lines.splice(i,1);if(!lines.length)lines.push({itemId:'',name:'',qty:1,rate:0});PF.rows();PF.calc()},
    newItemPrompt:()=>{const n=prompt('सामानको नाम?');if(!n)return;const r=num(prompt('खरिद दर?'));const pr=num(prompt('बिक्री दर?'));const it=put('items',{name:n,cat:'',unit:'पिस',cost:r,price:pr,qty:0,low:5,createdAt:now()});lines.push({itemId:it.id,name:it.name,qty:1,rate:r});PF.rows();PF.calc();toast('थपियो','ok')},
    sub:()=>lines.reduce((s,l)=>s+num(l.qty)*num(l.rate),0),
    total:()=>Math.max(0,PF.sub()-num(V('discount'))),
    pd:()=>{paidDirty=true;PF.calc()},
    calc:()=>{const sub=PF.sub(),t=PF.total(),paid=num(V('paid'));const a=$('#psub'),b=$('#ptot'),c=$('#pdiff');if(a)a.textContent=fmt(sub);if(b)b.textContent=fmt(t);if(c)c.textContent=fmt(t-paid);if($('#mf [name="paid"]')&&!paidDirty)$('#mf [name="paid"]').value=t||''},
    save:()=>{
      const supName=V('supplierName').trim();if(!supName){toast('सप्लायर','err');return}
      lines=lines.filter(l=>String(l.name).trim()||num(l.rate));
      if(!lines.length){toast('कम्तीमा एउटा सामान','err');return}
      const addStock=$('#mf [name="addStock"]').checked;
      const o=ed?Object.assign({},ed):{payments:[],createdAt:now(),by:ME.id,byName:ME.name,no:nextNo('purchase')};
      o.date=V('date')||today();o.supplierName=supName;o.supplierId=ensureSupplier(supName,'');o.billNo=V('billNo').trim();
      o.lines=clone(lines);o.discount=num(V('discount'));o.total=PF.total();o.method=V('method');o.note=V('note');
      if(ed&&ed._stockApplied)ed.lines.forEach(l=>{if(l.itemId&&DB.items[l.itemId]){const it=DB.items[l.itemId];put('items',Object.assign({},it,{qty:num(it.qty)-num(l.qty)}))}});
      if(addStock){o.lines.forEach(l=>{let it=l.itemId?DB.items[l.itemId]:null;if(!it)it=list('items').find(x=>x.name.toLowerCase()===String(l.name).trim().toLowerCase());if(it){put('items',Object.assign({},it,{qty:num(it.qty)+num(l.qty),cost:num(l.rate)||it.cost}))}else{const ni=put('items',{name:l.name,cat:'',unit:'पिस',cost:num(l.rate),price:0,qty:num(l.qty),low:5,createdAt:now()});l.itemId=ni.id}});o._stockApplied=true}
      if(!ed){const paid=num(V('paid'));if(paid>0)o.payments.push({amt:paid,method:V('method'),at:now(),by:ME.id,byName:ME.name})}
      put('purchases',o);
      if(!ed){const paid=num(V('paid'));if(paid>0)put('expenses',{date:o.date,cat:'स्टेशनरी खरिद',amt:paid,method:o.method,note:'खरिद बिल '+o.no+' — '+o.supplierName,by:ME.id,byName:ME.name,at:now(),ref:{col:'purchases',id:o.id}})}
      log(ed?'update':'create',`${o.no} खरिद ${ed?'सच्यायो':'दर्ता'} – ${supName} (${fmt(o.total)})`,{col:'purchases',id:o.id});
      closeModal();toast('सेभ: '+o.no,'ok');
      if(!ed&&confirm('खरिद बिल प्रिन्ट गर्ने?'))printPurchase(o.id);
    }
  };
  window.PF=PF;
  openModal(ed?'खरिद सच्याउने: '+ed.no:'नयाँ खरिद बिल',body,{sticky:true,wide:true,doing:'खरिद बिल बनाउँदै'});
  $('#mbody').insertAdjacentHTML('afterbegin','<datalist id="itemdl">'+list('items').map(i=>`<option value="${esc(i.name)}">`).join('')+'</datalist>');
  PF.rows();PF.calc();
}
function printPurchase(id){
  const b=DB.purchases[id];if(!b)return;const s=S();const paid=paidOf(b);
  const rows=b.lines.map(l=>`<tr><td>${esc(l.name)}</td><td class="r">${l.qty}×${l.rate}</td><td class="r">${num(l.qty)*num(l.rate)}</td></tr>`).join('');
  printHTML(`<h3>${esc(s.shop)}</h3><p>${esc(s.addr)} · ${esc(s.phone)}</p><hr><p style="text-align:left">खरिद बिल: ${esc(b.no)}<br>सप्लायर बिल: ${esc(b.billNo||'-')}<br>मिति: ${esc(b.date)}<br>सप्लायर: ${esc(b.supplierName||'-')}</p><hr><table>${rows}</table><hr><table><tr><td>उप-जम्मा</td><td class="r">${num(b.total)+num(b.discount)}</td></tr><tr><td>छुट</td><td class="r">${num(b.discount)}</td></tr><tr><td><b>कुल</b></td><td class="r"><b>${num(b.total)}</b></td></tr><tr><td>तिरेको</td><td class="r">${paid}</td></tr><tr><td>बाँकी</td><td class="r">${Math.max(0,num(b.total)-paid)}</td></tr></table>`,"body{font-family:'Mukta','Noto Sans Devanagari',sans-serif;width:76mm;margin:0 auto;font-size:12px}table{width:100%;border-collapse:collapse}td{padding:1px 0;vertical-align:top}.r{text-align:right}hr{border:0;border-top:1px dashed #000}h3,p{margin:3px 0;text-align:center}@page{margin:4mm}");
}
PAGES.purchase={title:'खरिद (Purchase Entry)',html(){return `<div class="row"><button class="btn bp" onclick="purchaseForm()">＋ नयाँ खरिद बिल</button><input class="grow" placeholder="बिल नं. / सप्लायर" value="${esc(fget('purchase','q',''))}" oninput="setF('purchase','q',this.value)"><select onchange="setF('purchase','per',this.value)">${opts(PERS,fget('purchase','per','month'))}</select></div><div id="lst"></div>`},
list(){const q=fget('purchase','q','').toLowerCase(),per=fget('purchase','per','month');const a=list('purchases').filter(p=>inPer(Date.parse(p.date+'T12:00:00'),per)&&(!q||(p.no+' '+(p.supplierName||'')+' '+(p.billNo||'')).toLowerCase().includes(q))).sort((x,y)=>y.date.localeCompare(x.date));const tot=a.reduce((s,p)=>s+num(p.total),0);const paid=a.reduce((s,p)=>s+paidOf(p),0);return `<p class="mut">${a.length} बिल · कुल ${fmt(tot)} · तिरेको ${fmt(paid)} · बाँकी ${fmt(tot-paid)}</p>`+tbl(['नं.','मिति','सप्लायर','बिल नं.','कुल|r','तिरेको|r','बाँकी|r',''],a.map(p=>`<tr class="clk" onclick="detail('purchases','${p.id}')"><td>${esc(p.no)}</td><td>${esc(p.date)}</td><td>${esc(p.supplierName)}</td><td>${esc(p.billNo||'-')}</td><td class="r">${fmt(p.total)}</td><td class="r">${fmt(paidOf(p))}</td><td class="r" style="color:${num(p.total)-paidOf(p)>0?'var(--er)':'var(--ok)'}">${fmt(num(p.total)-paidOf(p))}</td><td style="white-space:nowrap"><button class="btn bs" onclick="event.stopPropagation();purchaseForm('${p.id}')">✏️</button> <button class="btn bs bd" onclick="event.stopPropagation();delPurchase('${p.id}')">🗑️</button></td></tr>`),'खरिद बिल छैन')}};
function delPurchase(id){const p=DB.purchases[id];if(!p||!confirm(p.no+' मेटाउने? स्टक फिर्ता हुनेछ।'))return;if(p._stockApplied)p.lines.forEach(l=>{if(l.itemId&&DB.items[l.itemId]){const it=DB.items[l.itemId];put('items',Object.assign({},it,{qty:num(it.qty)-num(l.qty)}))}});del('purchases',id);log('delete','खरिद बिल मेटायो: '+p.no);closeModal()}
