function supForm(id){const s=id?DB.suppliers[id]:{};openModal(id?'सप्लायर सच्याउने':'नयाँ सप्लायर',()=>`<form id="mf" onsubmit="return false"><label>नाम *</label><input name="name" value="${esc(s.name||'')}"><label>फोन</label><input name="phone" value="${esc(s.phone||'')}"><label>ठेगाना</label><input name="addr" value="${esc(s.addr||'')}"><label>PAN</label><input name="pan" value="${esc(s.pan||'')}"><label>कैफियत</label><textarea name="note">${esc(s.note||'')}</textarea><div class="foot"><button type="button" class="btn" onclick="closeModal()">रद्द</button><button type="button" class="btn bp" onclick="saveSup('${id||''}')">सेभ</button></div></form>`,{sticky:true})}
