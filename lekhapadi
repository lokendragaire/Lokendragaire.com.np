PAGES.activity={title:'स्टाफ गतिविधि',html(){if(ME.role!=='admin')return '<p class="mut">अनुमति छैन</p>';return `<div class="card"><h3>🟢 अहिले</h3><div id="live"></div></div><div class="card"><h3>आजको सारांश</h3><div id="sum"></div></div><div class="row"><select onchange="setF('activity','u',this.value)"><option value="">सबै</option>${opts(list('users').map(u=>[u.id,u.name]),fget('activity','u',''))}</select></div><div class="card" style="padding:0"><div id="lst"></div></div>`},
  after(){this.partial()},
