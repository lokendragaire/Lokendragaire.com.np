<!DOCTYPE html>
<html lang="ne">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>डिजिटल निमन्त्रणा कार्ड निर्माता</title>
<style>
  *{box-sizing:border-box}
  body{margin:0;background:#f4efe4;color:#28221b;font-family:"Noto Sans Devanagari","Mangal",sans-serif}
  .app{max-width:1100px;margin:28px auto;padding:18px}
  .top{text-align:center;margin-bottom:18px}
  h1{font-size:25px;margin:0 0 7px;color:#8e1711}
  .sub{color:#66594b;font-size:14px}
  .layout{display:grid;grid-template-columns:320px minmax(0,1fr);gap:22px;align-items:start}
  .panel{background:#fff;border:1px solid #e5d6bd;border-radius:16px;padding:20px;box-shadow:0 8px 25px #50330d12;position:sticky;top:16px}
  label{display:block;font-weight:700;margin:4px 0 9px}
  input{width:100%;padding:13px 12px;border:1px solid #cbb99b;border-radius:9px;font-size:17px;font-family:inherit;outline:none}
  input:focus{border-color:#b3271c;box-shadow:0 0 0 3px #b3271c18}
  .hint{font-size:12px;color:#766b5e;line-height:1.7;margin:9px 0 17px}
  button{width:100%;border:0;border-radius:9px;padding:13px 12px;font-size:15px;font-weight:700;font-family:inherit;cursor:pointer;margin-top:9px}
  .download{background:#a91e17;color:white}
  .download:hover{background:#86150f}
  .reset{background:#f1e8d9;color:#514331}
  .preview{background:#fff;border-radius:14px;padding:10px;box-shadow:0 8px 25px #50330d12}
  canvas{display:block;width:100%;height:auto;border-radius:5px}
  .note{text-align:center;font-size:12px;color:#74695b;margin:10px 0 0}
  @media(max-width:760px){.layout{grid-template-columns:1fr}.panel{position:static}.app{padding:12px;margin:10px auto}h1{font-size:21px}}
</style>
</head>
<body>
<div class="app">
  <div class="top">
    <h1>डिजिटल निमन्त्रणा कार्ड निर्माता</h1>
    <div class="sub">व्यक्तिको नाम लेख्नुहोस्, कार्ड हेर्नुहोस् र PNG फोटोका रूपमा डाउनलोड गर्नुहोस्।</div>
  </div>
  <div class="layout">
    <section class="panel">
      <label for="personName">श्री पछाडि राख्ने व्यक्तिको नाम</label>
      <input id="personName" type="text" placeholder="जस्तै: राम बहादुर सुबेदी" autocomplete="off">
      <div class="hint">नाम लेख्दै जाँदा कार्डमा तुरुन्तै देखिन्छ। नाम खाली राखेमा मूल कार्ड जस्ताको तस्तै रहनेछ। नामको लम्बाइअनुसार अक्षरको आकार स्वतः मिलाइनेछ।</div>
      <button class="download" id="downloadBtn">कार्ड डाउनलोड गर्नुहोस् (PNG)</button>
      <button class="reset" id="resetBtn">नाम हटाउनुहोस्</button>
      <div class="note">डाउनलोड भएको फोटो फेसबुक, मेसेन्जर, भाइबर तथा अन्य सामाजिक सञ्जालमा शेयर गर्न सकिन्छ।</div>
    </section>
    <section class="preview">
      <canvas id="cardCanvas" width="1447" height="2048"></canvas>
      <div class="note">पूर्वावलोकन — डाउनलोड गर्दा यही गुणस्तरको कार्ड प्राप्त हुनेछ।</div>
    </section>
  </div>
</div>
<script>
const imageData = "data:image/jpeg;base64,";
const img = new Image();
const canvas = document.getElementById("cardCanvas");
const ctx = canvas.getContext("2d");
const input = document.getElementById("personName");

function drawCard(){
  if(!img.complete || !img.naturalWidth) return;
  ctx.clearRect(0,0,canvas.width,canvas.height);
  ctx.drawImage(img,0,0,canvas.width,canvas.height);
  const name = input.value.trim();
  if(name){
    // मूल कार्डको "श्री" पछाडि नाम राख्ने स्थान
    const x = 285, y = 765;
    let size = 43;
    ctx.font = `700 ${size}px "Noto Sans Devanagari","Mangal",sans-serif`;
    const maxWidth = 900;
    while(ctx.measureText(name).width > maxWidth && size > 24){
      size -= 1;
      ctx.font = `700 ${size}px "Noto Sans Devanagari","Mangal",sans-serif`;
    }
    ctx.textAlign = "left";
    ctx.textBaseline = "alphabetic";
    ctx.lineJoin = "round";
    ctx.strokeStyle = "#fff9e9";
    ctx.lineWidth = 5;
    ctx.strokeText(name, x, y);
    ctx.fillStyle = "#080604";
    ctx.fillText(name, x, y);
  }
}
img.onload = drawCard;
img.src = imageData;
input.addEventListener("input",drawCard);
document.getElementById("resetBtn").addEventListener("click",()=>{
  input.value="";
  drawCard();
});
document.getElementById("downloadBtn").addEventListener("click",()=>{
  drawCard();
  const link=document.createElement("a");
  link.download=(input.value.trim() ? input.value.trim().replace(/[^\p{L}\p{N}\-_ ]/gu,"").replace(/\s+/g,"_") : "nimantrana_card")+".png";
  link.href=canvas.toDataURL("image/png");
  link.click();
});
</script>
</body>
</html>
